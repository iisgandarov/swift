# Copy to .env.local and fill in. Never commit real values.
# Leave the Supabase values empty to run in local demo mode (fake user, mocked AI + calendar).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# AI (server-side only) — understands voice tasks and text tasks.
# AI_PROVIDER = gemini (default) | openai | mock (mock is used automatically in demo/dev without keys)
AI_PROVIDER=gemini
# Google AI Studio key (starts with "AIza"): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# A current Gemini Flash model that accepts audio input
GEMINI_MODEL=gemini-3.8-flash

# Optional alternative provider (AI_PROVIDER=openai)
OPENAI_API_KEY=
STT_MODEL=
PARSE_MODEL=

# 32 random bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Comma-separated list of Google accounts allowed to sign in
ALLOWED_EMAILS=isgandarov.israfil@gmail.com

APP_URL=http://localhost:3000
