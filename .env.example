# Copy to .env.local and fill in. Never commit real values.
# Leave the Supabase values empty to run in local demo mode (fake user, mocked AI + calendar).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# AI (server-side only). AI_PROVIDER=openai|mock (mock is used automatically when OPENAI_API_KEY is empty)
AI_PROVIDER=openai
OPENAI_API_KEY=
STT_MODEL=gpt-4o-transcribe
PARSE_MODEL=gpt-4.1-mini

# 32 random bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Comma-separated list of Google accounts allowed to sign in
ALLOWED_EMAILS=isgandarov.israfil@gmail.com

APP_URL=http://localhost:3000
